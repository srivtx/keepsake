{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srivtx.github.io/keepsake/spec/keepsake-v1.schema.json",
  "title": "keepsake vault",
  "description": "A keepsake/v1 vault: an encrypted, portable container of AI memory cells.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "createdAt",
    "cells",
    "kdf",
    "cipher",
    "ciphertext",
    "merkle"
  ],
  "properties": {
    "format": {
      "description": "The format identifier. Always exactly keepsake/v1.",
      "const": "keepsake/v1"
    },
    "createdAt": {
      "description": "When the vault was sealed, ISO 8601 UTC with millisecond precision.",
      "$ref": "#/$defs/Timestamp"
    },
    "cells": {
      "description": "The number of cells in the decrypted plaintext array.",
      "type": "integer",
      "minimum": 0
    },
    "kdf": {
      "description": "Key-derivation parameters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iterations", "salt"],
      "properties": {
        "name": {
          "const": "PBKDF2-SHA256"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "salt": {
          "description": "Base64 of exactly 16 random bytes.",
          "$ref": "#/$defs/Base64"
        }
      }
    },
    "cipher": {
      "description": "Authenticated-encryption parameters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iv"],
      "properties": {
        "name": {
          "const": "AES-GCM"
        },
        "iv": {
          "description": "Base64 of exactly 12 random bytes.",
          "$ref": "#/$defs/Base64"
        }
      }
    },
    "ciphertext": {
      "description": "Base64 of the AES-256-GCM output, with the 16-byte authentication tag appended.",
      "$ref": "#/$defs/Base64"
    },
    "merkle": {
      "description": "Lowercase hex Merkle root of the plaintext cell hashes.",
      "$ref": "#/$defs/Sha256Hex"
    }
  },
  "$defs": {
    "Cell": {
      "title": "Cell",
      "description": "One unit of memory: a hashed, timestamped record with a role and a source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source", "role", "createdAt", "tags", "hash"],
      "properties": {
        "id": {
          "description": "A UUID in canonical lowercase hyphenated form.",
          "$ref": "#/$defs/Uuid"
        },
        "text": {
          "description": "The cell content. UTF-8, non-empty after trimming.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "description": "A stable origin label such as chatgpt-export or notes.md.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "description": "Who produced the cell.",
          "enum": ["user", "assistant", "note", "system"]
        },
        "createdAt": {
          "description": "When the record was created, ISO 8601 UTC with millisecond precision.",
          "$ref": "#/$defs/Timestamp"
        },
        "tags": {
          "description": "Zero or more normalized tags. Order is significant.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "hash": {
          "description": "Lowercase hex SHA-256 of the canonical payload (the six fields other than hash).",
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Base64": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
