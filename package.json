{
  "name": "keepsake",
  "version": "0.4.0",
  "description": "Own your AI memory. Import an export or your notes, search it locally, seal it into an encrypted portable .keepsake vault, and let any agent recall it over MCP.",
  "type": "module",
  "author": "svx",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/cli.ts"
  ],
  "private": true,
  "bin": {
    "keepsake": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "mcp",
    "portable",
    "encrypted",
    "local-first",
    "privacy",
    "crdt",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "repository": "https://github.com/srivtx/keepsake",
  "homepage": "https://srivtx.github.io/keepsake",
  "bugs": {
    "url": "https://github.com/srivtx/keepsake/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "spec",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
